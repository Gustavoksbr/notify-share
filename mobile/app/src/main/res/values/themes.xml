<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema so do window. Toda a aparencia vem do Compose (NotifyShareTheme).
        Isto existe para o Android ter o que pintar antes do primeiro frame:
        sem a cor certa aqui, o app pisca branco ao abrir.
    -->
    <style name="Theme.NotifyShare" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- So para a RedirectUriReceiverActivity do AppAuth (fallback de login pelo
         navegador): ela precisa de um tema Theme.AppCompat (ou descendente) —
         sem isso o app crasha ao voltar do navegador com "You need to use a
         Theme.AppCompat theme". Nao afeta o resto do app, que usa Compose puro. -->
    <style name="Theme.AppAuthRedirect" parent="Theme.AppCompat.NoActionBar" />
</resources>
