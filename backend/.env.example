# =========================================================================
#  Tres ambientes:
#   - dev local ....... perfil padrao, usa DATABASE_URL_DEV
#   - e2e local ....... scripts/run-e2e.ps1 (injeta SPRING_DATASOURCE_URL)
#   - producao ........ SPRING_PROFILES_ACTIVE=prod, usa DATABASE_URL (Supabase)
# =========================================================================

# Postgres local de desenvolvimento.
DATABASE_URL_DEV=jdbc:postgresql://localhost:5432/notifyshare?user=postgres&password=root

# Supabase (so lido quando SPRING_PROFILES_ACTIVE=prod).
# Use a string do "Session pooler" (porta 5432 do host ...pooler.supabase.com):
#   jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?user=postgres.<project-ref>&password=<senha>&sslmode=require
#
#   sslmode=require    -> obrigatorio, o Supabase so aceita TLS
#   prepareThreshold=0 -> NAO precisa no session pooler; so no transaction
#                         pooler (porta 6543), que nao suporta prepared statements
#
# Hospedando na Render: a Render nao fala IPv6, e a conexao DIRETA do Supabase
#   (db.<ref>.supabase.co) hoje e IPv6-only. Ou seja, da Render TEM que ser o
#   pooler (host ...pooler.supabase.com, que e IPv4). Session pooler, porta 5432.
#   A porta HTTP a Render passa em PORT — o profile prod ja escuta nela.
DATABASE_URL=

# Client ID "Web application" do Google Cloud. Vazio = login com Google off.
GOOGLE_CLIENT_ID=

# --- JWT ---
# Obrigatorio fora da sua maquina. Pelo menos 32 bytes.
# JWT_SECRET=

# --- FCM (push) ---
# enabled=false desliga o push (vira no-op que so loga).
# FCM_ENABLED=true
# Em dev: deixe o firebase-service-account.json em backend/ e nao mexa aqui.
# FCM_CREDENTIALS_PATH=firebase-service-account.json
# Em producao: cole o JSON inteiro da conta de servico aqui e nao suba arquivo.
# FCM_CREDENTIALS={"type":"service_account",...}

# --- Swagger ---
# O perfil prod ja desliga o Swagger. Fora dele, para desligar manualmente:
# SWAGGER_ENABLED=false

# --- Self-ping (mantem o Render/Supabase acordados) ---
# URL publica desta API. Vazio = desligado (dev). Em producao, a propria URL da
# Render, ex.: https://notify-share-backend.onrender.com
# API_PRODUCTION_URL=
