SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/notifyshare?user=postgres&password=root
GOOGLE_CLIENT_ID=

# --- JWT ---
# Obrigatorio fora da sua maquina. Pelo menos 32 bytes.
# JWT_SECRET=

# --- FCM (push) ---
# enabled=false desliga o push (vira no-op que so loga).
# FCM_ENABLED=true
# Em dev: deixe o firebase-service-account.json em backend/ e nao mexa aqui.
# FCM_CREDENTIALS_PATH=firebase-service-account.json
# Em producao: cole o JSON inteiro da conta de servico aqui e nao suba arquivo.
# FCM_CREDENTIALS={"type":"service_account",...}

# --- Swagger ---
# SWAGGER_ENABLED=false   # producao
