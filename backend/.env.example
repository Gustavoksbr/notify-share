DATABASE_URL_DEV=jdbc:postgresql://localhost:5432/notifyshare?user=postgres&password=root

DATABASE_URL=

GOOGLE_CLIENT_ID=

# Recuperacao de senha por e-mail (Resend — https://resend.com).
# Vazio: o codigo vai pro log em vez de ser enviado (dev).
RESEND_API_KEY=
# Remetente verificado, ex.: Notify Share <nao-responda@seu-dominio.com>
RESEND_EMAIL_FROM=

# Bloqueio da recuperacao de senha (codigos errados sao contados POR IP).
# Padrao: 4 pedidos por IP em 15 minutos; 5 erros -> 5 minutos travado.
PASSWORD_RESET_RATE_LIMIT_WINDOW=PT15M
PASSWORD_RESET_MAX_REQUESTS=4
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_LOCKOUT_DURATION=PT5M
PASSWORD_RESET_CODE_TTL=PT20M
PASSWORD_RESET_SEND_COOLDOWN=PT60S

# Bloqueio do login normal por senha errada (por nickname/e-mail digitado).
LOGIN_MAX_ATTEMPTS=11
LOGIN_LOCKOUT_DURATION=PT1M
LOGIN_RATE_LIMIT_WINDOW=PT5M
